{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evomate.dev/schemas/agent-genome.schema.json",
  "title": "EvoMate AgentGenome",
  "type": "object",
  "required": ["id", "name", "version", "source", "chromosomes"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "source": { "type": "string" },
    "chromosomes": {
      "type": "object",
      "required": ["cognitive", "tool", "memory", "personality", "safety"],
      "properties": {
        "cognitive": { "$ref": "./chromosome.schema.json" },
        "tool": { "$ref": "./chromosome.schema.json" },
        "memory": { "$ref": "./chromosome.schema.json" },
        "personality": { "$ref": "./chromosome.schema.json" },
        "safety": { "$ref": "./chromosome.schema.json" }
      },
      "additionalProperties": true
    },
    "genes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
