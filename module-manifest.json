{
  "project": "EvoMate",
  "version": "0.1.0",
  "updatedAt": "2026-04-25",
  "principle": "Contract-first distributed hackathon development",
  "contracts": {
    "GenomeBundle": {
      "source": "data/mock/agents.json",
      "shape": {
        "arenaTask": "string",
        "agents": "AgentGenome[]"
      }
    },
    "AgentGenome": {
      "required": [
        "id",
        "name",
        "archetype",
        "rarity",
        "avatar",
        "soul",
        "skills",
        "memory",
        "knowledge",
        "radar",
        "style"
      ],
      "radarKeys": [
        "logic",
        "creativity",
        "empathy",
        "autonomy",
        "risk"
      ]
    },
    "CoreEngineApi": [
      "calculateCompatibility(parentA, parentB)",
      "fuseGenomes(parentA, parentB, compatibility)",
      "generateArenaOutputs(task, parentA, parentB, child)"
    ],
    "DemoStages": [
      "lab-entrance",
      "match-room",
      "fusion-chamber",
      "child-report",
      "arena"
    ],
    "DemoEvents": [
      "evomate:parents-selected",
      "evomate:compatibility-ready",
      "evomate:fusion-started",
      "evomate:child-created",
      "evomate:arena-ready"
    ]
  },
  "modules": [
    {
      "id": "A",
      "name": "Product Narrative and Pitch",
      "ownerProfile": "Product, pitch, storytelling",
      "paths": [
        "docs-zh/",
        "lightning-pitch/",
        "README.md",
        "开发日志/"
      ],
      "outputContract": "PitchMessage"
    },
    {
      "id": "B",
      "name": "Frontend Experience and Motion",
      "ownerProfile": "Frontend, UI, motion design",
      "paths": [
        "apps/web/index.html",
        "apps/web/styles.css"
      ],
      "inputContracts": [
        "DemoStage",
        "AgentGenome",
        "FusionResult",
        "ArenaOutput[]"
      ],
      "outputContract": "DOM Slots and CSS Tokens"
    },
    {
      "id": "C",
      "name": "Frontend Orchestration",
      "ownerProfile": "Frontend integration",
      "paths": [
        "apps/web/app.js"
      ],
      "inputContracts": [
        "GenomeBundle",
        "CoreEngineApi"
      ],
      "outputContract": "Rendered Demo"
    },
    {
      "id": "D",
      "name": "Genome Core Logic",
      "ownerProfile": "Algorithm, agent, backend",
      "paths": [
        "src/core/compatibility-engine.js",
        "src/core/genome-engine.js",
        "src/core/fusion-engine.js",
        "src/core/gene-fusion-engine.js",
        "src/core/evaluation-engine.js",
        "src/core/evolution-service.js",
        "src/core/arena-engine.js",
        "src/README.md"
      ],
      "inputContracts": [
        "AgentGenome",
        "ArenaTask"
      ],
      "outputContracts": [
        "CompatibilityResult",
        "FusionResult",
        "ArenaOutput[]"
      ]
    },
    {
      "id": "E",
      "name": "Genome Data and Content",
      "ownerProfile": "Data, prompt, agent persona",
      "paths": [
        "data/mock/agents.json",
        "module-manifest.json",
        "schemas/"
      ],
      "outputContract": "GenomeBundle"
    },
    {
      "id": "F",
      "name": "OpenClaw and Evolver Adapter",
      "ownerProfile": "Runtime, framework, integration",
      "paths": [
        "src/integrations/openclaw/",
        "src/integrations/evolver/",
        "docs-zh/openclaw-evomate-integration-prd.zh-CN.md",
        "docs-zh/evolver-gene-layer-development-v1.zh-CN.md",
        "docs-zh/evolver-main-comparison.zh-CN.md"
      ],
      "outputContract": "AgentGenome[]"
    },
    {
      "id": "G",
      "name": "QA, Release, and Integration",
      "ownerProfile": "Testing, release, engineering PM",
      "paths": [
        "scripts/",
        "package.json",
        "README.md",
        "开发日志/"
      ],
      "outputContract": "ReleaseCandidate"
    }
  ],
  "releaseCandidate": {
    "mustPass": [
      "npm run check",
      "local demo opens",
      "breed flow works",
      "child report renders",
      "arena comparison renders",
      "development log updated"
    ]
  }
}
